# Google Sheets Configuration
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_CLIENT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# Google Drive Folder IDs (for organizing uploaded images)
GOOGLE_DRIVE_LTC_FOLDER_ID=your_ltc_photos_folder_id
GOOGLE_DRIVE_CG_FOLDER_ID=your_cg_photos_folder_id
GOOGLE_DRIVE_CM_FOLDER_ID=your_cm_photos_folder_id
GOOGLE_DRIVE_VISIT_FOLDER_ID=your_visit_photos_folder_id

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_with_openssl

# Application Configuration
NODE_ENV=development
